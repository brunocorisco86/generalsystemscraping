# ==============================================================================
# [01] NOCTUA IOT - INTEGRAÇÃO DIRETA APPSYNC GRAPHQL
# ==============================================================================
# Endpoint GraphQL do AWS AppSync do Noctua IoT
NOCTUA_APPSYNC_URL=https://qhurq5cthrd75ppzeyutzcclje.appsync-api.sa-east-1.amazonaws.com/graphql

# Chave de API (X-Api-Key) obtida na aba Network (F12) filtrando por graphql
NOCTUA_API_KEY=da2-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Identificadores de Hardware (MAC addresses dos ativos)
NOCTUA_GATEWAY_ID=10:20:BA:65:3A:B8
NOCTUA_ENDPOINT_TANQUE_1=10:20:BA:66:2E:C8
NOCTUA_ENDPOINT_TANQUE_2=10:20:BA:6A:90:00

# Trava de Segurança: quando 'true', bloqueia chamadas que alterem estado físico de motores
NOCTUA_READ_ONLY=true

# ==============================================================================
# [02] INFRAESTRUTURA DE REDE E PORTAS (EVITAR CONFLITOS NA VPS)
# ==============================================================================
# Porta externa para publicação do Dashboard Web (altere se a VPS já usar 5000)
WEB_PORT=5000
WEB_HOST=0.0.0.0
FLASK_SECRET_KEY=gerar_chave_segura_com_secrets_token_hex_32

# Credenciais de acesso ao Dashboard Web
WEB_ADMIN_USER=admin
WEB_ADMIN_PASS=admin123

# ==============================================================================
# [03] BANCO DE DADOS (HÍBRIDO: SQLITE BORDA + POSTGRESQL HISTÓRICO)
# ==============================================================================
SQLITE_DB_PATH=data/piscicultura_dados.db

# Configurações PostgreSQL (Se na VPS já existir um Postgres, aponte para ele)
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=piscicultura_history
PG_USER=postgres
PG_PASSWORD=sua_senha_segura

# ==============================================================================
# [04] BOT TELEGRAM (PEIXEPATELBOT) & ALERTAS
# ==============================================================================
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_GROUP_ID=-100123456789
TELEGRAM_CHAT_ID=-100123456789
TELEGRAM_ADMIN_ID=123456789
TELEGRAM_ADMIN_USERNAME=@seu_usuario

# Parâmetros de Alerta
LIMITE_OXIGENIO_CRITICO=2.0
MINUTOS_OFFLINE_ALERTA=15
FEED_LIMITE_TRATO=3.0
OX_LIMITE_SEGURANCA=2.0

# ==============================================================================
# [05] INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI)
# ==============================================================================
GOOGLE_API_KEY=AIzaSy...seu_api_key_aqui
GEMINI_MODEL_NAME=gemini-flash-latest

# ==============================================================================
# [06] IDENTIFICAÇÃO DO PROPRIETÁRIO E PROPRIEDADE
# ==============================================================================
OWNER_NAME=Seu Nome Completo
OWNER_CPF=000.000.000-00
PROP_NAME=Piscicultura Patel
PROP_ADDRESS=Endereço Completo da Propriedade
PROP_CADPRO=80.000.000-0
STRUCT_NAME=Tanque 01
STRUCT_PLUSCODE=87G8+H6 Cidade
STRUCT_TYPE_ID=1
STRUCT_MACS=Tanque 1:10:20:BA:66:2E:C8, Tanque 2:10:20:BA:6A:90:00
LATITUDE_SEDE=-24.000000
LONGITUDE_SEDE=-53.000000

# ==============================================================================
# [07] BACKUP (CLOUDFLARE R2) - OPCIONAL
# ==============================================================================
R2_ACCESS_KEY_ID=seu_r2_access_key_id
R2_SECRET_ACCESS_KEY=seu_r2_secret_access_key
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=nome_do_seu_bucket
