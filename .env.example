# --- [00] Identificação do Proprietário (Admin) ---
OWNER_NAME=Seu Nome Completo
TELEGRAM_ADMIN_ID=123456789
TELEGRAM_ADMIN_USERNAME=@seu_usuario

# --- [01] Identificação da Propriedade ---
PROP_NAME=Nome da Sua Fazenda/Propriedade

# --- [03] Configuração do Bot Telegram Unificado ---
# Token principal (PeixePatelBot)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_GROUP_ID=-100123456789
TELEGRAM_CHAT_ID=-100123456789

# --- [04] Banco de Dados ---
SQLITE_DB_PATH=data/piscicultura_dados.db
PG_HOST=localhost
PG_DBNAME=piscicultura
PG_USER=postgres
PG_PASSWORD=sua_senha_segura
PG_PORT=5433

# --- [05] Infraestrutura Local ---
PROJECT_ROOT=/path/to/9_ALPINE_GENERAL
REPORTS_DIR=reports
LOGS_DIR=logs

# --- [06] Scraping (Selenium - Noctua-IoT) ---
URL_LOGIN=https://noctua-iot.com.br/login
LOGIN_EMAIL=seu_email@exemplo.com
LOGIN_PASSWORD=sua_senha_login
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# --- [07] Alertas e Monitoramento ---
LIMITE_OXIGENIO_CRITICO=4.0
MINUTOS_OFFLINE_ALERTA=15
FEED_LIMITE_TRATO=3.0
OX_LIMITE_SEGURANCA=2.0

# --- [08] Interface Web (Dashboard) ---
WEB_ADMIN_USER=admin
WEB_ADMIN_PASS=admin123
# FLASK_SECRET_KEY=será_gerada_automaticamente_pelo_setup

# --- [09] Inteligência Artificial (Google Gemini) ---
# Necessário para o Agente de monitoramento e análise de falsos positivos
GOOGLE_API_KEY=AIzaSy...seu_api_key_aqui
GEMINI_MODEL_NAME=gemini-flash-latest

# --- [10] Dados Complementares para População Inicial ---
OWNER_CPF=000.000.000-00
PROP_ADDRESS=Endereço Completo da Propriedade
PROP_CADPRO=80.000.000-0
STRUCT_NAME=Tanque 01
STRUCT_PLUSCODE=87G8+H6 Cidade
STRUCT_TYPE_ID=1
STRUCT_MACS=Tanque 1:10:20:BA:66:2E:C8, Tanque 2:10:20:BA:6A:90:00
LATITUDE_SEDE=-24.000000
LONGITUDE_SEDE=-53.000000
